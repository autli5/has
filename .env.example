# ==========================================
# Настройки подключения к базе данных PostgreSQL
# ==========================================

# Хост сервера PostgreSQL (IP-адрес или домен вашего сервера)
DB_HOST=127.0.0.1

# Порт PostgreSQL (по умолчанию 5432)
DB_PORT=5432

# Имя пользователя базы данных
DB_USER=postgres

# Пароль пользователя базы данных
DB_PASSWORD=your_password_here

# Имя базы данных
DB_NAME=postgres

# Режим SSL: disable, prefer, require (по умолчанию: prefer)
DB_SSL_MODE=prefer

# Или прямая строка подключения DATABASE_URL (если указана, имеет приоритет):
# DATABASE_URL=postgres://user:password@host:port/dbname

# ------------------------------------------
# Настройки таблицы пользователей
# ------------------------------------------
# Название таблицы с пользователями (по умолчанию: users)
DB_USERS_TABLE=users

# Название колонки email/логина (по умолчанию: email)
DB_EMAIL_COLUMN=email

# Название колонки пароля (по умолчанию: password)
DB_PASSWORD_COLUMN=password

# ------------------------------------------
# Настройки отправки почты (SMTP для сброса пароля)
# ------------------------------------------
# Хост SMTP сервера (например: smtp.gmail.com, smtp.mail.ru, smtp.yandex.ru)
# Если не заполнено, код выводится в интерфейсе в тестовом режиме для удобной проверки
SMTP_HOST=

# Порт SMTP (обычно 465 для SSL/TLS или 587)
SMTP_PORT=465

# Логин и пароль от почты для отправки
SMTP_USER=
SMTP_PASSWORD=

# Email отправителя (если не указан, используется SMTP_USER)
SMTP_FROM=
