{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "has",
  "version": "0.0.6",
  "identifier": "com.has.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "has",
        "width": 920,
        "height": 720,
        "minWidth": 440,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      },
      "nsis": {
        "languages": ["Russian"],
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "librsvg2-common"
        ],
        "recommends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "librsvg2"
        ],
        "recommends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQUVFQTk4QkE5REVFNjMKUldSajdwMjZtT3F1UGFzWUFIcjNNcjRUdnlGKzBzUGxTZ3BOTGFWcGRwN2pCd1JJTnRXbTE2d3EK",
      "endpoints": [
        "https://github.com/autli5/has/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
